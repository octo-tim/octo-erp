{
  "name": "octo-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Octo Works self-built ERP (RFP v0.3)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "serve": "node tools/serve.mjs",
    "worker": "tsx src/server/jobs/worker.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "traceability": "node tools/traceability.mjs",
    "traceability:check": "node tools/traceability.mjs --check",
    "docs:schema": "node tools/docs-schema.mjs",
    "docs:api": "node tools/docs-api.mjs",
    "docs:permissions": "node tools/docs-permissions.mjs",
    "docs:check": "node tools/docs-schema.mjs --check && node tools/docs-api.mjs --check && node tools/docs-permissions.mjs --check",
    "audit:check": "node tools/audit-check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-pdf/renderer": "4.9.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "9.2.4",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "@types/pg": "^8.23.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "lucide-react": "1.37.0",
    "next": "15.5.24",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.3",
    "@playwright/test": "1.62.1",
    "@prisma/schema-engine-wasm": "^7.10.0-7.561d7b42579a2459cc8edf3788918b626c640023",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.24",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "3.9.6",
    "prisma": "^7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
