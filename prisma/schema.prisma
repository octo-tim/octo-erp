// Octo ERP — Prisma schema
// Rules: docs/engineering-rules.md §3. Money = Decimal(18,0) KRW, qty = Decimal(18,3), unit price = Decimal(18,4).
// Ledger tables are append-only (DB triggers in migrations forbid UPDATE/DELETE).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Organization / Identity ─────────────────────────

model Department {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  parentId      String?
  parent        Department? @relation("DeptTree", fields: [parentId], references: [id])
  children      Department[] @relation("DeptTree")
  headEmployeeId String?
  validFrom     DateTime @db.Date
  validTo       DateTime? @db.Date
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employees     Employee[]
  histories     DepartmentHistory[]
  assignments   Assignment[]

  @@index([parentId])
}

model Division {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userScopes UserDivisionScope[]
  stockDocuments StockDocument[]
}

model Employee {
  id             String   @id @default(cuid())
  employeeNo     String   @unique
  name           String
  birthDate      DateTime? @db.Date
  phone          String?
  email          String?
  address        String?
  hireDate       DateTime @db.Date
  leaveDate      DateTime? @db.Date
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  positionCode   String?  // 직위 공통코드
  jobTitle       String?
  employmentType String   @default("REGULAR") // REGULAR | CONTRACT | PARTTIME | INTERN
  status         String   @default("ACTIVE")  // ACTIVE | ON_LEAVE | RESIGNED
  contractEndDate DateTime? @db.Date
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User?
  sensitive      EmployeeSensitive?
  assignments    Assignment[]
  departmentHistories DepartmentHistory[]
  attendances    Attendance[]
  attendanceCorrections AttendanceCorrectionRequest[]
  leaveGrants    LeaveGrant[]
  leaveUsages    LeaveUsage[]
  leaveRequests  LeaveRequest[]
  documents      EmployeeDocument[]
  certificates   CertificateIssue[]
  changeRequests EmployeeChangeRequest[]
  sensitiveAccessLogs SensitiveAccessLog[]

  @@index([departmentId])
  @@index([status])
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String
  displayName        String
  email              String?
  employeeId         String?   @unique
  employee           Employee? @relation(fields: [employeeId], references: [id])
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  roles           UserRole[]
  divisionScopes  UserDivisionScope[]
  warehouseScopes UserWarehouseScope[]
  sessions        Session[]
  loginAttempts   LoginAttempt[]
  notifications   Notification[]
  preferences     UserPreference[]
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique // module.action
  module      String
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserDivisionScope {
  userId     String
  divisionId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@id([userId, divisionId])
}

model UserWarehouseScope {
  userId      String
  warehouseId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
}

model Session {
  id         String    @id // opaque 256-bit token hash
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  ip         String?
  userAgent  String?
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  success   Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@index([username, createdAt])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  type      String   // LOGIN_FAILED | ACCOUNT_LOCKED | ACCOUNT_UNLOCKED | PASSWORD_RESET | FORBIDDEN | SENSITIVE_ACCESS | SESSION_REVOKED
  userId    String?
  actorId   String?
  ip        String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

// ───────────────────────── Cross-cutting infrastructure ─────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  meta       Json?
  ip         String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model IdempotencyRecord {
  id           String   @id @default(cuid())
  scope        String
  requestId    String
  status       String   @default("IN_PROGRESS") // IN_PROGRESS | DONE
  responseJson Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([scope, requestId])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  topic         String
  payload       Json
  dedupKey      String?
  status        String    @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  attempt       Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  lockedBy      String?
  lockedAt      DateTime?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([topic, dedupKey])
  @@index([status, nextAttemptAt])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   String    // APPROVAL | STOCK | CREDIT | HR | SYSTEM
  title      String
  body       String?
  linkUrl    String?
  readAt     DateTime?
  /**
   * UIX-08: collapses repeats of the same alert for one user. Callers scope it by whatever
   * makes a repeat uninteresting - INV-07 uses item + business date, so a day of issues on
   * one item produces one row, not one per movement.
   */
  dedupKey   String?
  createdAt  DateTime  @default(now())

  deliveries NotificationDelivery[]

  @@unique([userId, dedupKey])
  @@index([userId, readAt, createdAt])
}

model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        String       // EMAIL | MESSENGER
  status         String       @default("PENDING") // PENDING | SENT | FAILED
  attempt        Int          @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([notificationId])
}

model Attachment {
  id           String   @id @default(cuid())
  storageKey   String   @unique
  originalName String
  mimeType     String
  size         Int
  ownerType    String   // SALES_DOC | PARTNER | APPROVAL_DOC | EMPLOYEE_DOC | ITEM | ...
  ownerId      String
  accessScope  String   @default("OWNER") // OWNER | DIVISION | HR | PUBLIC_INTERNAL
  uploadedById String?
  sha256       String?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([ownerType, ownerId])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model PolicyVersion {
  id            String   @id @default(cuid())
  policyKey     String   // inventory.valuation | money | approval.matrix | period | leave | retention | notification
  version       Int
  effectiveFrom DateTime @db.Date
  config        Json
  note          String?
  createdById   String?
  createdAt     DateTime @default(now())

  @@unique([policyKey, version])
  @@index([policyKey, effectiveFrom])
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // GRID_COLUMNS | SEARCH_FILTER | DASHBOARD
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([userId, kind, key])
}

model NumberingRule {
  id         String   @id @default(cuid())
  docType    String   @unique
  prefix     String
  periodKind String   @default("MONTH") // NONE | YEAR | MONTH
  seqLength  Int      @default(4)
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt

  counters NumberingCounter[]
}

model NumberingCounter {
  ruleId    String
  periodKey String
  lastSeq   Int      @default(0)
  rule      NumberingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([ruleId, periodKey])
}

// ───────────────────────── Master data (BAS) — base tables needed by scopes ─────────────────────────

model Warehouse {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  type       String   @default("NORMAL") // NORMAL | DEFECT | CONSIGNED
  managerEmployeeId String?
  address    String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userScopes UserWarehouseScope[]
  stockFrom  StockDocument[] @relation("StockFrom")
  stockTo    StockDocument[] @relation("StockTo")
  ledger     InventoryLedger[]
  snapshots  StockSnapshot[]
  counts     StockCount[]
}

// ───────────────────────── HRM (STEP 4) ─────────────────────────

model EmployeeSensitive {
  employeeId     String   @id
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  residentNoEnc  String?
  residentNoLast4 String?
  bankName       String?
  bankAccountEnc String?
  bankAccountLast4 String?
  keyVersion     Int      @default(1)
  updatedAt      DateTime @updatedAt
}

model SensitiveAccessLog {
  id         String   @id @default(cuid())
  actorId    String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  field      String
  reason     String
  ip         String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([employeeId, createdAt])
}

model DepartmentHistory {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employeeId   String?
  employee     Employee?  @relation(fields: [employeeId], references: [id])
  changeType   String     // CREATED | RENAMED | MOVED | HEAD_CHANGED | CLOSED | REORG
  snapshot     Json
  effectiveDate DateTime  @db.Date
  note         String?
  createdAt    DateTime   @default(now())

  @@index([departmentId, effectiveDate])
}

model Assignment {
  id            String     @id @default(cuid())
  employeeId    String
  employee      Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          String     // HIRE | PROMOTION | TRANSFER | LEAVE_OF_ABSENCE | RETURN | RESIGN
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  positionCode  String?
  jobTitle      String?
  employmentType String?
  effectiveFrom DateTime   @db.Date
  effectiveTo   DateTime?  @db.Date
  note          String?
  approvalDocId String?
  createdById   String?
  createdAt     DateTime   @default(now())

  @@index([employeeId, effectiveFrom])
}

model Attendance {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate     DateTime @db.Date
  checkIn      DateTime?
  checkOut     DateTime?
  status       String   @default("NORMAL") // NORMAL | LATE | EARLY_LEAVE | ABSENT | LEAVE | HALF_LEAVE | HOLIDAY | BUSINESS_TRIP
  workMinutes  Int      @default(0)
  overtimeMinutes Int   @default(0)
  nightMinutes Int      @default(0)
  holidayMinutes Int    @default(0)
  source       String   @default("WEB") // WEB | MOBILE | UPLOAD | CORRECTION | LEAVE
  note         String?
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([employeeId, workDate])
}

model AttendanceCorrectionRequest {
  id           String   @id @default(cuid())
  docNo        String   @unique
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate     DateTime @db.Date
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  requestedStatus   String?
  reason       String
  status       String   @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | CANCELED
  approvalDocId String?
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId, workDate])
}

model LeaveGrant {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     String   @default("ANNUAL")
  days          Decimal  @db.Decimal(6, 2)
  grantDate     DateTime @db.Date
  expiresAt     DateTime @db.Date
  policyVersionId String?
  reason        String?
  sourceType    String?  // POLICY | MANUAL | MIGRATION | EXPIRY
  sourceId      String?
  createdAt     DateTime @default(now())

  @@index([employeeId, leaveType, expiresAt])
}

model LeaveUsage {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     String   @default("ANNUAL")
  days          Decimal  @db.Decimal(6, 2) // positive = use, negative = reversal
  usageDate     DateTime @db.Date
  leaveRequestId String?
  leaveRequest  LeaveRequest? @relation(fields: [leaveRequestId], references: [id])
  reversalOfId  String?  @unique
  sourceType    String   // REQUEST | REVERSAL | MIGRATION
  sourceId      String?
  createdAt     DateTime @default(now())

  @@unique([sourceType, sourceId, usageDate])
  @@index([employeeId, usageDate])
}

model LeaveRequest {
  id           String   @id @default(cuid())
  docNo        String   @unique
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    String   @default("ANNUAL")
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  days         Decimal  @db.Decimal(6, 2)
  halfDay      String?  // AM | PM
  reason       String?
  status       String   @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | CANCELED
  approvalDocId String?
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  usages LeaveUsage[]

  @@index([employeeId, startDate])
}

model EmployeeDocument {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  docType      String   // CONTRACT | ID_COPY | CERTIFICATE | OTHER
  title        String
  attachmentId String?
  issuedAt     DateTime? @db.Date
  expiresAt    DateTime? @db.Date
  note         String?
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([employeeId])
  @@index([expiresAt])
}

model CertificateIssue {
  id          String   @id @default(cuid())
  issueNo     String   @unique
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  certType    String   // EMPLOYMENT | CAREER
  purpose     String?
  issuedById  String
  attachmentId String?
  createdAt   DateTime @default(now())

  @@index([employeeId])
}

model EmployeeChangeRequest {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  changes      Json     // { field: {before, after} } — non-sensitive only
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewerId   String?
  reviewNote   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId, status])
}

model RetentionRun {
  id          String   @id @default(cuid())
  policyKey   String
  status      String   @default("PLANNED") // PLANNED | APPROVED | EXECUTED | FAILED
  targetCount Int      @default(0)
  processedCount Int   @default(0)
  approvedById String?
  executedAt  DateTime?
  result      Json?
  createdAt   DateTime @default(now())
}

// ───────────────────────── Approval (APV) — STEP 5 ─────────────────────────

model ApprovalForm {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String   @default("GENERAL") // GENERAL | EXPENSE | PURCHASE | CONTRACT | HR
  targetType  String?  // links the form to a business object handler (APV-08/09)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions ApprovalFormVersion[]
}

model ApprovalFormVersion {
  id            String   @id @default(cuid())
  formId        String
  form          ApprovalForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  version       Int
  /** ApprovalFieldSchema[] — dynamic field definitions (APV-01) */
  fieldSchema   Json
  bodyTemplate  String?
  defaultLineTemplateId String?
  effectiveFrom DateTime @db.Date
  isActive      Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())

  documents ApprovalDocument[]

  @@unique([formId, version])
}

model ApprovalLineTemplate {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  /** allow the drafter to edit the generated line (APV-03) */
  editable  Boolean  @default(true)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps ApprovalLineTemplateStep[]
}

model ApprovalLineTemplateStep {
  id            String @id @default(cuid())
  templateId    String
  template      ApprovalLineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stepNo        Int
  /** APPROVE | AGREE (병렬합의) | REFERENCE (참조·열람) */
  role          String @default("APPROVE")
  /** resolution strategy: USER | POSITION | DEPARTMENT_HEAD | DRAFTER_MANAGER */
  resolveBy     String @default("USER")
  userId        String?
  positionCode  String?
  departmentId  String?
  /** APV-05: only added when the document amount is at or above this threshold */
  minAmount     Decimal? @db.Decimal(18, 0)
  /** APV-04: this step may finalise the document without later steps */
  canFinalize   Boolean @default(false)

  @@unique([templateId, stepNo])
}

model ApprovalRule {
  id             String  @id @default(cuid())
  code           String  @unique
  name           String
  formId         String?
  /** all conditions must match for the rule to apply */
  divisionId     String?
  departmentId   String?
  minAmount      Decimal? @db.Decimal(18, 0)
  maxAmount      Decimal? @db.Decimal(18, 0)
  lineTemplateId String
  priority       Int     @default(0)
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Delegation {
  id            String   @id @default(cuid())
  /** the absent approver */
  fromUserId    String
  /** the deputy who may act in their place (APV-04) */
  toUserId      String
  validFrom     DateTime @db.Date
  validTo       DateTime @db.Date
  reason        String?
  isActive      Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([fromUserId, validFrom, validTo])
}

model ApprovalDocument {
  id            String   @id @default(cuid())
  docNo         String   @unique
  formVersionId String
  formVersion   ApprovalFormVersion @relation(fields: [formVersionId], references: [id])
  /** APV-01: snapshot of the form schema and rendered body at submit time */
  formSnapshot  Json
  title         String
  content       Json
  drafterId     String
  drafterEmployeeId String?
  divisionId    String?
  departmentId  String?
  amount        Decimal? @db.Decimal(18, 0)
  status        String   @default("DRAFT") // DRAFT | IN_PROGRESS | ON_HOLD | APPROVED | REJECTED | WITHDRAWN | CANCELED
  currentStepNo Int      @default(0)
  version       Int      @default(1)
  submittedAt   DateTime?
  completedAt   DateTime?
  policyVersionId String?
  /** the document this one cancels (APV-12) */
  cancelsDocumentId String? @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  steps        ApprovalStep[]
  participants ApprovalParticipant[]
  actions      ApprovalActionLog[]
  links        ApprovalLink[]

  @@index([status, currentStepNo])
  @@index([drafterId, createdAt])
}

model ApprovalStep {
  id            String   @id @default(cuid())
  documentId    String
  document      ApprovalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  stepNo        Int
  role          String   @default("APPROVE") // APPROVE | AGREE | REFERENCE
  approverId    String
  /** set when a deputy acted instead of the assigned approver (APV-04) */
  actedByUserId String?
  canFinalize   Boolean  @default(false)
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED | ON_HOLD | SKIPPED
  comment       String?
  actedAt       DateTime?
  createdAt     DateTime @default(now())

  @@unique([documentId, stepNo])
  @@index([approverId, status])
}

model ApprovalParticipant {
  id         String @id @default(cuid())
  documentId String
  document   ApprovalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  role       String @default("REFERENCE") // REFERENCE | VIEWER
  readAt     DateTime?

  @@unique([documentId, userId, role])
}

model ApprovalActionLog {
  id         String   @id @default(cuid())
  documentId String
  document   ApprovalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  stepNo     Int?
  actorId    String
  actedByUserId String?
  action     String   // SUBMIT | APPROVE | REJECT | HOLD | WITHDRAW | RESUBMIT | CANCEL | READ
  comment    String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@unique([documentId, stepNo, action, requestId])
  @@index([documentId, createdAt])
}

model ApprovalLink {
  id            String   @id @default(cuid())
  documentId    String
  document      ApprovalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  targetType    String
  targetId      String
  targetVersion Int
  createdAt     DateTime @default(now())

  @@unique([targetType, targetId, targetVersion])
  @@index([documentId])
}

// ───────────────────────── Master data (BAS) — STEP 6 ─────────────────────────

model ItemCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  /** 1..3 — the RFP requires a three-level classification (BAS-01) */
  level     Int
  parentId  String?
  parent    ItemCategory? @relation("CategoryTree", fields: [parentId], references: [id])
  children  ItemCategory[] @relation("CategoryTree")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  @@index([parentId])
  @@index([level])
}

model Item {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  spec          String?
  unitCode      String   @default("EA")
  categoryId    String?
  category      ItemCategory? @relation(fields: [categoryId], references: [id])
  purchasePrice Decimal? @db.Decimal(18, 4)
  salesPrice    Decimal? @db.Decimal(18, 4)
  taxType       String   @default("TAXABLE") // TAXABLE | ZERO | EXEMPT
  barcode       String?
  // BAS-02 supplementary
  safetyStock   Decimal? @db.Decimal(18, 3)
  leadTimeDays  Int?
  defaultSupplierId String?
  defaultSupplier   Partner? @relation("DefaultSupplier", fields: [defaultSupplierId], references: [id])
  imageAttachmentId String?
  note          String?
  isActive      Boolean  @default(true)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stockLines  StockDocumentLine[]
  ledger      InventoryLedger[]
  snapshots   StockSnapshot[]
  countLines  StockCountLine[]
  periodCosts InventoryPeriodCost[]

  @@index([name])
  @@index([categoryId])
  @@index([isActive])
}

model Partner {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  businessNo     String?
  ceoName        String?
  businessType   String?  // 업태
  businessItem   String?  // 종목
  address        String?
  phone          String?
  email          String?
  /** CUSTOMER | SUPPLIER | BOTH */
  partnerType    String   @default("BOTH")
  paymentTerms   String?
  creditLimit    Decimal? @db.Decimal(18, 0)
  note           String?
  isActive       Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contacts     PartnerContact[]
  defaultForItems Item[] @relation("DefaultSupplier")
  stockDocuments  StockDocument[]

  @@index([name])
  @@index([businessNo])
  @@index([partnerType, isActive])
}

model PartnerContact {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name      String
  position  String?
  phone     String?
  email     String?
  isPrimary Boolean @default(false)
  note      String?

  @@index([partnerId])
}

model CommonCode {
  id        String   @id @default(cuid())
  groupCode String   // UNIT | ITEM_CATEGORY | PAYMENT_METHOD | POSITION | ...
  code      String
  name      String
  value1    String?
  value2    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupCode, code])
  @@index([groupCode, isActive])
}

/** BAS-03: every bulk upload is a batch, so errors and partial application are auditable. */
model ImportBatch {
  id            String   @id @default(cuid())
  targetType    String   // ITEM | PARTNER | ...
  templateVersion Int    @default(1)
  fileName      String?
  totalRows     Int      @default(0)
  validRows     Int      @default(0)
  errorRows     Int      @default(0)
  appliedRows   Int      @default(0)
  status        String   @default("VALIDATED") // VALIDATED | APPLIED | FAILED
  errors        Json?
  createdById   String?
  createdAt     DateTime @default(now())
  appliedAt     DateTime?

  @@index([targetType, createdAt])
}

// ───────────────────────── Inventory (INV) — STEP 7 ─────────────────────────

/**
 * INV-01/02/03: one document shape carries receipts, issues and transfers.
 * A transfer is the only kind with both warehouses set, and the only kind that
 * moves through the IN_TRANSIT state (INV-03).
 */
model StockDocument {
  id            String   @id @default(cuid())
  docNo         String   @unique
  /** RECEIPT | ISSUE | TRANSFER | ADJUST */
  docType       String
  /** business date: the day the movement belongs to, which drives period close (DEC-04) */
  docDate       DateTime @db.Date
  /** DRAFT | PENDING_APPROVAL | CONFIRMED | CANCELED, plus IN_TRANSIT for transfers */
  status        String   @default("DRAFT")
  /** INV-03: REQUESTED | IN_TRANSIT | COMPLETED | CANCELED, null for non-transfers */
  movementState String?
  fromWarehouseId String?
  fromWarehouse   Warehouse? @relation("StockFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String?
  toWarehouse     Warehouse? @relation("StockTo", fields: [toWarehouseId], references: [id])
  partnerId     String?
  partner       Partner? @relation(fields: [partnerId], references: [id])
  /** INV-01/02: a manual receipt or issue must say why (common code STOCK_REASON_IN/OUT) */
  reasonCode    String?
  /** the sales/purchase document this movement was generated from, when not manual */
  sourceType    String?
  sourceId      String?
  divisionId    String?
  division      Division? @relation(fields: [divisionId], references: [id])
  note          String?
  totalQuantity Decimal  @default(0) @db.Decimal(18, 3)
  totalAmount   Decimal  @default(0) @db.Decimal(18, 0)
  version       Int      @default(1)
  confirmedAt   DateTime?
  confirmedById String?
  canceledAt    DateTime?
  canceledById  String?
  cancelReason  String?
  /** INV-08: the count this adjustment document was generated from */
  stockCountId  String?  @unique
  stockCount    StockCount? @relation(fields: [stockCountId], references: [id])
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lines StockDocumentLine[]

  @@index([docType, status, docDate])
  @@index([docDate])
  @@index([sourceType, sourceId])
}

model StockDocumentLine {
  id          String   @id @default(cuid())
  documentId  String
  document    StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  lineNo      Int
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id])
  quantity    Decimal  @db.Decimal(18, 3)
  /** receipts carry the acquisition cost; issues are valued by the DEC-01 policy at confirm time */
  unitCost    Decimal? @db.Decimal(18, 4)
  amount      Decimal  @default(0) @db.Decimal(18, 0)
  note        String?

  @@unique([documentId, lineNo])
  @@index([itemId])
}

/**
 * INV-04: the ledger is the single source of truth for stock on hand. Rows are
 * append-only - a cancellation writes an opposite row rather than deleting.
 * INT-04/INT-07.
 */
model InventoryLedger {
  id            String   @id @default(cuid())
  /** STOCK_DOCUMENT | SALES | PURCHASE | OPENING | VALUATION_ADJUST */
  sourceType    String
  sourceId      String
  sourceLineId  String?
  /** monotonically increasing per source, so a cancel row never collides with its original */
  sourceVersion Int      @default(1)
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id])
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  /** signed: positive is inbound, negative is outbound */
  quantity      Decimal  @db.Decimal(18, 3)
  unitCost      Decimal? @db.Decimal(18, 4)
  amount        Decimal  @default(0) @db.Decimal(18, 0)
  reason        String?
  /** the business day this movement belongs to, used by every period query */
  occurredAt    DateTime
  /** INV-09: set when a month close has already valued this row */
  valuationPeriod String?
  createdById   String?
  createdAt     DateTime @default(now())

  /** INT-05: the same source line can never produce two ledger rows for one version */
  @@unique([sourceType, sourceId, sourceLineId, sourceVersion])
  @@index([itemId, warehouseId, occurredAt])
  @@index([warehouseId, occurredAt])
  @@index([occurredAt])
  @@index([valuationPeriod])
}

/**
 * INV-04: a read cache over the ledger. Never authoritative - `rebuild` recreates
 * every row from InventoryLedger and `reconcile` reports drift.
 */
model StockSnapshot {
  id           String   @id @default(cuid())
  itemId       String
  item         Item     @relation(fields: [itemId], references: [id])
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  quantity     Decimal  @default(0) @db.Decimal(18, 3)
  amount       Decimal  @default(0) @db.Decimal(18, 0)
  updatedAt    DateTime @updatedAt

  @@unique([itemId, warehouseId])
  @@index([warehouseId])
}

/** INV-08: a physical count, its differences, and the adjustment it produces. */
model StockCount {
  id           String   @id @default(cuid())
  countNo      String   @unique
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  countDate    DateTime @db.Date
  /** DRAFT | COUNTING | PENDING_APPROVAL | APPROVED | CANCELED */
  status       String   @default("DRAFT")
  /** the ledger position frozen when counting started, so later movements do not distort the difference */
  frozenAt     DateTime?
  note         String?
  version      Int      @default(1)
  approvedAt   DateTime?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines      StockCountLine[]
  adjustment StockDocument?

  @@index([warehouseId, countDate])
}

model StockCountLine {
  id           String   @id @default(cuid())
  countId      String
  count        StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item     @relation(fields: [itemId], references: [id])
  /** what the ledger said when the count was frozen */
  systemQty    Decimal  @db.Decimal(18, 3)
  /** what was actually on the shelf; null until counted */
  countedQty   Decimal? @db.Decimal(18, 3)
  reason       String?

  @@unique([countId, itemId])
  @@index([itemId])
}

/** INV-09 / DEC-01: monthly total-average valuation, provisional until the month closes. */
model InventoryValuationPeriod {
  id           String   @id @default(cuid())
  /** YYYY-MM */
  period       String   @unique
  /** OPEN | CLOSED */
  status       String   @default("OPEN")
  policyVersionId String?
  closedAt     DateTime?
  closedById   String?
  reopenedAt   DateTime?
  reopenReason String?
  createdAt    DateTime @default(now())

  costs InventoryPeriodCost[]
}

/** the confirmed month-end average per item, and the closing position it implies. */
model InventoryPeriodCost {
  id           String   @id @default(cuid())
  periodId     String
  period       InventoryValuationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item     @relation(fields: [itemId], references: [id])
  openingQty   Decimal  @db.Decimal(18, 3)
  openingAmount Decimal @db.Decimal(18, 0)
  inQty        Decimal  @db.Decimal(18, 3)
  inAmount     Decimal  @db.Decimal(18, 0)
  outQty       Decimal  @db.Decimal(18, 3)
  /** what the issues were provisionally valued at during the month */
  provisionalOutAmount Decimal @db.Decimal(18, 0)
  /** the confirmed month total average unit cost */
  averageCost  Decimal  @db.Decimal(18, 4)
  /** outQty x averageCost, truncated to KRW */
  finalOutAmount Decimal @db.Decimal(18, 0)
  /** finalOutAmount - provisionalOutAmount, posted as a VALUATION_ADJUST ledger row */
  adjustment   Decimal  @db.Decimal(18, 0)
  closingQty   Decimal  @db.Decimal(18, 3)
  closingAmount Decimal @db.Decimal(18, 0)

  @@unique([periodId, itemId])
  @@index([itemId])
}
